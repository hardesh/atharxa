ge": "screens"}, "n1": {"x": 4164, "y": 0, "w": 360, "text": "Look: Material 3, Roboto. Default theme: Forest (first run); Teal and Ocean are the other built-in themes, chosen in You › Appearance and synced between devices. Every board has a Dark tweak. Phones use 130% text by default (Mac 100%).\n\nEvery main screen has the shared top app bar: title, a filled AI button and your avatar (opens “You”: profile + settings) on phone; title, a filled “Ask AI ⌘K” button and avatar with sync dot on Mac.\n\nSample data is consistent: per-100 g values × grams; totals add up.", "fill": "green", "page": "screens"}, "t2": {"x": 0, "y": -300, "text": "Workflows end to end", "kind": "title1", "maxW": 4084, "page": "flows"}, "t4": {"x": 0, "y": -300, "text": "Color palettes — Forest, Teal, Ocean ship; B, C, F explored", "kind": "title1", "maxW": 2772, "page": "colors"}, "t5": {"x": 0, "y": -300, "text": "Scaling across phone sizes", "kind": "title1", "maxW": 2000, "page": "sizes"}, "t3": {"x": 0, "y": -300, "text": "Empty states & first run", "kind": "title1", "maxW": 2318, "page": "states"}, "t6": {"x": 0, "y": -300, "text": "Atharxa — app icon", "kind": "title1", "maxW": 2000, "page": "brand"}}, "designSystems": []}